# URL of the local WhatsApp Cloudflare Worker (apps/worker), started via `wrangler dev`
VITE_WA_API_URL=http://localhost:8787
# Public URL of the engine worker for WebSocket connections from the browser.
# In dev this is the same as the API URL; in prod it's the workers.dev domain.
VITE_ENGINE_URL=http://localhost:8787
# The engine's internal secret is server-side only: set it in `.dev.vars`
# (and `wrangler secret put`) as ENGINE_INTERNAL_SECRET. It must never live
# in a VITE_ file -- this file is bundled into the browser.
